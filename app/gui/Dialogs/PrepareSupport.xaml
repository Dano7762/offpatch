<!--
  Assistant « Préparer un support » (cahier des charges 7.4). Chargé par Import-OpMainWindow -Path (PrepareSupport.ps1) :
  ni classe compilée ni gestionnaire d'événement ici, le câblage se fait en PowerShell par les noms (x:Name).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OffPatch — Préparer un support"
        Width="760" Height="600" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="16">
        <!-- 1. Lecteur de destination. -->
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Left" Text="Lecteur de destination :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button x:Name="BtnSupportRefresh" DockPanel.Dock="Right" Content="Actualiser" Padding="12,3" Margin="8,0,0,0"
                    ToolTip="Relire la liste des lecteurs (clé branchée après l'ouverture de la fenêtre)" />
            <ComboBox x:Name="SupportDrive" DisplayMemberPath="Label" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="OffPatch est copié à la racine du lecteur. Les rapports déjà présents sur le support sont conservés." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnSupportPrepare" Content="Préparer le support" Padding="14,4" Margin="0,0,8,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="BtnSupportClose" Content="Fermer" Padding="14,4" IsCancel="True" />
        </StackPanel>

        <!-- 3. Contrôles : système de fichiers, espace, refus et avertissements. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="SupportSummary" TextWrapping="Wrap" />
            <Border x:Name="SupportBlocking" Visibility="Collapsed" Padding="8,4" Margin="0,8,0,0" CornerRadius="3" Background="#FDE7E9">
                <TextBlock x:Name="SupportBlockingText" TextWrapping="Wrap" Foreground="#A4262C" />
            </Border>
            <Border x:Name="SupportWarnings" Visibility="Collapsed" Padding="8,4" Margin="0,8,0,0" CornerRadius="3" Background="#FFF4CE">
                <TextBlock x:Name="SupportWarningsText" TextWrapping="Wrap" Foreground="#5C4400" />
            </Border>
        </StackPanel>

        <!-- 2. Contenu : cibles Windows et sources Office à embarquer. -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Windows" Margin="0,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SupportTargets" Margin="4" />
                </ScrollViewer>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Office" Margin="6,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SupportSources" Margin="4" />
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
