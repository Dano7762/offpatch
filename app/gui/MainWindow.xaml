<!--
  Fenêtre principale d'OffPatch (cahier des charges 9). Chargée par XamlReader (MainWindow.ps1) : ni classe compilée
  ni gestionnaire d'événement ici, le câblage se fait en PowerShell par les noms (x:Name).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OffPatch"
        Width="1100" Height="760" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,5" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- En-tête : logo, nom et version, date du dépôt, alerte de fraîcheur. -->
        <Border x:Name="Header" DockPanel.Dock="Top" Padding="16,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo chargé par Register-OpHeader (OffPatch.jpg), masqué s'il manque. -->
                    <Image x:Name="HeaderLogo" Height="56" Margin="0,0,12,0" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="HeaderTitle" Text="OffPatch" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderVersion" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="HeaderAlert" Visibility="Collapsed" Padding="8,2" Margin="0,0,12,0" CornerRadius="3" Background="#FFF4CE">
                        <TextBlock x:Name="HeaderAlertText" Foreground="#5C4400" />
                    </Border>
                    <TextBlock x:Name="HeaderDepotDate" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pied : auteur, licence, dépôt du projet (lien ouvert par Register-OpHeader). -->
        <Border DockPanel.Dock="Bottom" Padding="16,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <TextBlock x:Name="Footer" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                <Run Text="© 2026 David Informaticien · Licence MIT · " />
                <Hyperlink x:Name="FooterLink" NavigateUri="https://github.com/Dano7762/offpatch" ToolTip="Ouvrir le dépôt du projet dans le navigateur">github.com/Dano7762/offpatch</Hyperlink>
            </TextBlock>
        </Border>

        <TabControl x:Name="MainTabs" Margin="8">
            <TabItem x:Name="TabPc" Header="Ce PC">
                <Grid x:Name="PcRoot" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="140" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Bandeau système. -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="PcSystemTitle" FontSize="15" FontWeight="SemiBold" Text="Relevé du PC en cours…" TextWrapping="Wrap" />
                        <TextBlock x:Name="PcSystemDetail" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </StackPanel>

                    <!-- Contrôles préalables qui ne sont pas Ok. -->
                    <Border x:Name="PcChecks" Grid.Row="1" Visibility="Collapsed" Padding="8,4" Margin="0,0,0,8" CornerRadius="3" Background="#FFF4CE">
                        <TextBlock x:Name="PcChecksText" TextWrapping="Wrap" Foreground="#5C4400" />
                    </Border>

                    <!-- Redémarrage nécessaire. -->
                    <Border x:Name="PcRebootBanner" Grid.Row="2" Visibility="Collapsed" Padding="8,4" Margin="0,0,0,8" CornerRadius="3" Background="#DEECF9">
                        <DockPanel>
                            <Button x:Name="BtnRestart" DockPanel.Dock="Right" Content="Redémarrer maintenant" Padding="12,3" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Un redémarrage est en attente sur ce PC : redémarrer avant d'installer d'autres mises à jour." />
                        </DockPanel>
                    </Border>

                    <!-- Étapes du plan ; case à cocher pour le mode manuel. -->
                    <DataGrid x:Name="PcSteps" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="32">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Pending}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Étape" Binding="{Binding CategoryLabel}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="Détail" Binding="{Binding Detail}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="État" Binding="{Binding StateLabel}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="Motif" Binding="{Binding Reason}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Office (lecture seule). -->
                    <TextBlock x:Name="PcOfficeText" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <!-- Boutons. -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnAuto" Content="Installation automatique" Padding="14,4" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="BtnInstallSelection" Content="Installer la sélection" Padding="14,4" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="BtnResume" Content="Reprendre la session interrompue" Padding="14,4" Visibility="Collapsed" ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>

                    <!-- Avancement et dernières lignes du journal. -->
                    <StackPanel Grid.Row="6" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock x:Name="PcCurrentStep" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="BtnCancelReboot" DockPanel.Dock="Right" Content="Annuler le redémarrage" Padding="12,2" Margin="8,0,0,0" Visibility="Collapsed" />
                            <ProgressBar x:Name="PcProgress" Height="14" Minimum="0" Maximum="1" Value="0" />
                        </DockPanel>
                        <ListBox x:Name="PcLastLog" Height="110" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="TabDepot" Header="Dépôt">
                <Grid x:Name="DepotRoot" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="140" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Résumé : date, taille totale, fraîcheur. -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Border x:Name="DepotAlert" DockPanel.Dock="Right" Visibility="Collapsed" Padding="8,2" CornerRadius="3" Background="#FFF4CE" VerticalAlignment="Center">
                            <TextBlock x:Name="DepotAlertText" Foreground="#5C4400" />
                        </Border>
                        <TextBlock x:Name="DepotSummary" FontSize="15" FontWeight="SemiBold" Text="Lecture du dépôt en cours…" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Cibles et sources Office (settings.json, config\office\sources.json). -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Cibles Windows" Padding="6" Margin="0,0,8,0">
                            <StackPanel x:Name="DepotTargets" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Sources Office (langues séparées par des virgules, forme xx-xx)" Padding="6">
                            <StackPanel x:Name="DepotSources" />
                        </GroupBox>
                        <Button x:Name="BtnSaveSelection" Grid.Column="2" Content="Enregistrer la sélection" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Bottom" IsEnabled="False" />
                    </Grid>

                    <!-- Contenu du manifeste. -->
                    <DataGrid x:Name="DepotItems" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cible" Binding="{Binding Target}" Width="Auto" />
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryLabel}" Width="Auto" />
                            <DataGridTextColumn Header="KB ou version" Binding="{Binding Detail}" Width="Auto" />
                            <DataGridTextColumn Header="Date" Binding="{Binding ReleaseDate}" Width="Auto" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="Auto" />
                            <DataGridTextColumn Header="Fichiers" Binding="{Binding Integrity}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Boutons. -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnDepotCheck" Content="Vérifier les nouveautés" Padding="14,4" Margin="0,0,8,0" />
                        <Button x:Name="BtnDepotUpdate" Content="Mettre à jour le dépôt" Padding="14,4" Margin="0,0,8,0" />
                        <Button x:Name="BtnDepotPurge" Content="Purger" Padding="14,4" Margin="0,0,8,0" />
                        <Button x:Name="BtnPrepareSupport" Content="Préparer un support…" Padding="14,4" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="BtnDepotCancel" Content="Annuler" Padding="14,4" IsEnabled="False"
                                ToolTipService.ShowOnDisabled="True" ToolTip="Arrête le téléchargement en cours ; il reprendra au prochain lancement. Une source Office en cours va jusqu'au bout." />
                    </StackPanel>

                    <!-- Avancement et dernières lignes du journal. -->
                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock x:Name="DepotCurrent" TextTrimming="CharacterEllipsis" />
                        <ListBox x:Name="DepotLastLog" Height="130" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="TabLog" Header="Journal">
                <Grid x:Name="LogRoot" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filtre par niveau et dossiers. -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnOpenLogs" Content="Ouvrir le dossier des journaux" Padding="14,4" Margin="0,0,8,0" />
                            <Button x:Name="BtnOpenReports" Content="Ouvrir le dossier des rapports" Padding="14,4" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Niveau :" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="LogLevelFilter" SelectedIndex="0" MinWidth="260">
                                <ComboBoxItem Tag="DEBUG" Content="Tous les niveaux" />
                                <ComboBoxItem Tag="INFO" Content="Informations, avertissements et erreurs" />
                                <ComboBoxItem Tag="WARN" Content="Avertissements et erreurs" />
                                <ComboBoxItem Tag="ERROR" Content="Erreurs seulement" />
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>

                    <!-- Journal en direct de tous les traitements lancés depuis la fenêtre. -->
                    <ListBox x:Name="LogList" Grid.Row="1" FontFamily="Consolas" FontSize="12" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
